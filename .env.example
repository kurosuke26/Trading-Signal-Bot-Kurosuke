# Discord Webhook URLs - 本番用
DISCORD_WEBHOOK_URL_LONG_PROD=https://discordapp.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
DISCORD_WEBHOOK_URL_SHORT_PROD=https://discordapp.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
DISCORD_WEBHOOK_URL_WARNING_PROD=https://discordapp.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
DISCORD_WEBHOOK_URL_PERFORMANCE_PROD=https://discordapp.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
DISCORD_WEBHOOK_URL_SAKATA_PROD=https://discordapp.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# J-Quants API（Freeプラン。data/jquants_cache/のバックフィル・更新に使用）
# JQUANTS_API_KEY=あなたのAPIキー  # 本番はGitHub Actions Secretsの JQUANTS_API_KEY を使用

# 環境設定
DEBUG=False
ENVIRONMENT=test  # or 'prod'

# 実行パラメータ（任意。未設定なら既定値を使用）
# MAX_TICKERS=50            # テスト用：対象銘柄数の上限（空欄・未設定なら全銘柄）
# TIME_BUDGET_MINUTES=240   # 実行時間の予算（分）
# FETCH_DELAY_MIN_SECONDS=1.5  # ファンダメンタルズ取得：1銘柄ごとの待機の下限（秒）
# FETCH_DELAY_MAX_SECONDS=2.5  # ファンダメンタルズ取得：1銘柄ごとの待機の上限（秒、ランダムでこの範囲に収まる）
# MARKETCAP_EXCLUDE_BOTTOM_PCT=25  # 時価総額の下位何%を除外するか（日曜の全銘柄実行結果を基に判定）
# MARKETCAP_EXCLUDE_TOP_PCT=10     # 時価総額の上位何%を除外するか（同上）
# FULL_UNIVERSE_WEEKDAY=6          # 全銘柄を対象に時価総額を再計算する曜日（0=月,...,6=日曜）
# MAX_SHARE_PRICE=20000            # この株価（円）以上の銘柄は値がさ株として除外
