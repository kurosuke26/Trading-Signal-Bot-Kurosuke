# Discord Webhook URLs - テスト用
DISCORD_WEBHOOK_URL_LONG_TEST=https://discordapp.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
DISCORD_WEBHOOK_URL_SHORT_TEST=https://discordapp.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
DISCORD_WEBHOOK_URL_WARNING_TEST=https://discordapp.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
DISCORD_WEBHOOK_URL_PERFORMANCE_TEST=https://discordapp.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
DISCORD_WEBHOOK_URL_SAKATA_TEST=https://discordapp.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Discord Webhook URLs - 本番用
DISCORD_WEBHOOK_URL_LONG_PROD=https://discordapp.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
DISCORD_WEBHOOK_URL_SHORT_PROD=https://discordapp.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
DISCORD_WEBHOOK_URL_WARNING_PROD=https://discordapp.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
DISCORD_WEBHOOK_URL_PERFORMANCE_PROD=https://discordapp.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
DISCORD_WEBHOOK_URL_SAKATA_PROD=https://discordapp.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# 環境設定
DEBUG=False
ENVIRONMENT=test  # or 'prod'

# 実行パラメータ（任意。未設定なら既定値を使用）
# MAX_TICKERS=50            # テスト用：対象銘柄数の上限（空欄・未設定なら全銘柄）
# TIME_BUDGET_MINUTES=240   # 実行時間の予算（分）

# --- J-Quantsバックテスト用（2026-09-04追加） ---
# J-Quantsダッシュボード（設定 » API キー）で発行したAPIキーをここに設定する
JQUANTS_API_KEY=your_jquants_api_key_here

# 任意：Phase 1の小規模テスト用に対象銘柄コード（4桁・カンマ区切り）を絞り込む場合に指定
# 未設定なら /equities/master から東証プライム/スタンダード/グロース全銘柄が対象になる
# JQUANTS_TICKERS=7203,6758,7974,9984,8306

# 任意：Freeプランのレート制限（5回/分）に合わせたリクエスト間隔（秒）。通常は変更不要
# JQUANTS_MIN_INTERVAL_SECONDS=13
